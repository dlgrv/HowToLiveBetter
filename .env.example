# Local secrets for LLM translation waves (CometAPI / OpenAI-compatible / etc.)
# Copy to .env and fill in. .env is gitignored — do not commit it.
#
#   cp .env.example .env

# Required when tools/llm adapter is used (local llama-server: any non-empty string)
HTLB_LLM_API_KEY=local

# --- Local Hy-MT2-30B-A3B Q8 (llama.cpp) ---
HTLB_LLM_BASE_URL=http://127.0.0.1:8080/v1
HTLB_LLM_MODEL=Hy-MT2-30B-A3B-Q8_0
# Factual unit translation; card default 0.7 is creative — keep low for HTLB
HTLB_LLM_TEMPERATURE=0.2
# Server context: start via tools/llm/start-llama-server.sh (default -c 16384).
# HTLB_LLAMA_CTX=16384

# --- Or cloud later (same client) ---
# HTLB_LLM_BASE_URL=https://api.cometapi.com/v1
# HTLB_LLM_MODEL=gemini-3.1-pro
# HTLB_LLM_API_KEY=

# Optional alias some clients read
# OPENAI_API_KEY=

# LanguageTool self-host (tools/lt_check.py); default if unset: http://127.0.0.1:8010
# HTLB_LT_BASE_URL=http://127.0.0.1:8010

# Factcheck live judge (tools/validate/factcheck.py without --stdin-verdict)
# ZAI_API_KEY=
# Or set tools/rules/project.yaml judge.backend: local-ollama
