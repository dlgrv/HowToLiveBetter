# Copy to /etc/htlb-api.env (root:root, mode 600). Do not commit real values.

HTLB_CORS_ORIGINS=https://book.dlgrv.com

# Required in production — long random string (vote fingerprints).
HTLB_VOTE_SALT=CHANGE_ME

# Optional tuning (defaults shown in api/internal/config).
# HTLB_GUEST_TTL_HOURS=2160
# HTLB_CLAIM_TTL_MINUTES=10

# OAuth (configure providers in PocketBase admin after first deploy).
HTLB_OAUTH_GOOGLE_CLIENT_ID=
HTLB_OAUTH_GOOGLE_CLIENT_SECRET=
HTLB_OAUTH_GITHUB_CLIENT_ID=
HTLB_OAUTH_GITHUB_CLIENT_SECRET=

# PocketBase field encryption: name of env var holding a 32-character key.
HTLB_ENCRYPTION_ENV=HTLB_PB_ENCRYPTION
# HTLB_PB_ENCRYPTION=
