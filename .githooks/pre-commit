#!/bin/sh
# Block commits that fail lint or published-book content gates
# (same checks as `make lint` / `make check-content` in CI).
set -e
cd "$(git rev-parse --show-toplevel)"
make lint
make check-content
# Extra Go lint when api/ paths are staged (make lint already runs api-lint if go present)
if git diff --cached --name-only | grep -q '^api/'; then
  if command -v go >/dev/null 2>&1; then
    make api-lint
  fi
fi
